          <h4 style="margin:4px 0;">⚖️ Ratio (Cement:Sand)</h4>
          <div style="display:flex; gap:8px; align-items:center;">
            <div style="flex:1;"><label style="font-size:0.7rem; color:#6a8aa8;">Cement</label><input type="number" class="tiling-cement-ratio" value="1" step="0.5"></div>
            <div style="flex:1;"><label style="font-size:0.7rem; color:#6a8aa8;">Sand</label><input type="number" class="tiling-sand-ratio" value="3" step="0.5"></div>
          </div>
        </div>
        <div style="margin-top:8px;">
          <h4 style="margin:4px 0;">💵 Prices</h4>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
            <div><label style="font-size:0.7rem; color:#6a8aa8;">Cement (per 50kg bag)</label><input type="number" class="tiling-cement-price" value="800" step="10"></div>
            <div><label style="font-size:0.7rem; color:#6a8aa8;">Sand (per ton)</label><input type="number" class="tiling-sand-price" value="1350" step="10"></div>
            <div><label style="font-size:0.7rem; color:#6a8aa8;">Tiles (per box)</label><input type="number" class="tiling-tile-price" value="1000" step="10"></div>
          </div>
        </div>
        <div style="margin-top:8px;">
          <h4 style="margin:4px 0;">🔧 Other Costs</h4>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px;">
            <div><label style="font-size:0.7rem; color:#6a8aa8;">Equipment</label><input type="number" class="tiling-equipment" value="5000" step="100"></div>
            <div><label style="font-size:0.7rem; color:#6a8aa8;">Labor (%)</label><input type="number" class="tiling-labor" value="25" step="1"></div>
            <div><label style="font-size:0.7rem; color:#6a8aa8;">Contractor (%)</label><input type="number" class="tiling-contractor" value="5" step="0.5"></div>
          </div>
        </div>
        <button class="btn" style="margin:10px 0 6px; padding:10px; font-size:0.85rem;" onclick="App.calculateItem('${id}')">⟳ Calculate Tiling ${index}</button>
        <div class="tiling-results"></div>
        <div class="item-total">Item Total: <span>0.00</span></div>
      `
    };
    return templates[type];
  },

  // ===== LOAD SAVED CALCULATIONS =====
  loadCalculations(type) {
    const container = document.getElementById(`${type}-container`);
    if (!container) return;
    container.innerHTML = '';
    this.counters[type] = 0;
    const saved = this.calculations[type] || [];
    saved.forEach((data, index) => {
      this.counters[type]++;
      const id = `${type}-item-${this.counters[type]}`;
      const block = document.createElement('div');
      block.className = 'item-block';
      block.id = id;
      block.dataset.consumed = 'true';
      block.innerHTML = this.getItemTemplate(type, id, this.counters[type]);
      container.appendChild(block);
      const resultsContainer = block.querySelector(`.${type}-results`);
      if (resultsContainer && data.items) {
        this.buildTable(resultsContainer, data.items);
        this.consumeInputs(block, type);
      }
    });
    this.updateCombined(type);
  },

  // ===== SAVE CALCULATION =====
  saveCalculation(type, id, items) {
    const calculationData = { id, type, items, timestamp: new Date().toISOString() };
    if (!this.calculations[type]) this.calculations[type] = [];
    this.calculations[type].push(calculationData);
  },

  // ===== CALCULATE ITEM =====
  calculateItem(id) {
    const block = document.getElementById(id);
    if (!block) return;
    if (block.dataset.consumed === 'true') {
      alert('⚠️ This calculation has already been consumed. Please add a new one.');
      return;
    }

    let type = 'walling';
    if (id.includes('concrete')) type = 'concrete';
    else if (id.includes('plaster')) type = 'plaster';
    else if (id.includes('painting')) type = 'painting';
    else if (id.includes('tiling')) type = 'tiling';

    const calculators = {
      walling: this.calcWalling.bind(this),
      concrete: this.calcConcrete.bind(this),
      plaster: this.calcPlaster.bind(this),
      painting: this.calcPainting.bind(this),
      tiling: this.calcTiling.bind(this)
    };
    
    const result = calculators[type](block);
    if (result) {
      this.saveCalculation(type, id, result.items);
      this.buildTable(block.querySelector(`.${type}-results`), result.items);
      this.updateCombined(type);
      this.consumeInputs(block, type);
      block.dataset.consumed = 'true';
    }
  },

  // ===== CONSUME INPUTS =====
  consumeInputs(block, type) {
    block.dataset.consumed = 'true';
    const inputSelectors = [
      '.walling-cement-ratio', '.walling-sand-ratio', '.walling-block-length',
      '.walling-block-thickness', '.walling-block-height', '.walling-area',
      '.concrete-cement-ratio', '.concrete-sand-ratio', '.concrete-ballast-ratio',
      '.concrete-volume', '.plaster-cement-ratio', '.plaster-sand-ratio',
      '.plaster-area', '.plaster-thickness',
      '.painting-structure', '.painting-area', '.painting-coats',
      '.painting-coverage', '.painting-primer-coverage', '.painting-thinner-percent',
      '.painting-filler-rate', '.painting-paint-price', '.painting-thinner-price',
      '.painting-filler-price', '.painting-primer-price', '.painting-equipment',
      '.painting-labor', '.painting-contractor',
      '.tiling-structure', '.tiling-area',
      '.tiling-tile-length', '.tiling-tile-width', '.tiling-tile-thickness',
      '.tiling-tile-collection', '.tiling-cement-ratio', '.tiling-sand-ratio',
      '.tiling-cement-price', '.tiling-sand-price', '.tiling-tile-price',
      '.tiling-equipment', '.tiling-labor', '.tiling-contractor'
    ];
    const allInputs = block.querySelectorAll('input, select');
    allInputs.forEach(input => {
      let shouldConsume = false;
      for (const selector of inputSelectors) {
        if (input.matches(selector)) { shouldConsume = true; break; }
      }
      if (shouldConsume) {
        const value = input.value;
        let labelText = '';
        const parentDiv = input.closest('div');
        if (parentDiv) {
          const label = parentDiv.querySelector('label');
          if (label) labelText = label.textContent + ' ';
        }
        const span = document.createElement('span');
        span.className = 'consumed-value';
        span.textContent = `${labelText}${value}`;
        input.parentNode.replaceChild(span, input);
      }
    });
    const calcBtn = block.querySelector('.btn:not(.btn-pdf):not(.btn-whatsapp)');
    if (calcBtn) {
      calcBtn.disabled = true;
      calcBtn.textContent = '✅ Calculated (Consumed)';
      calcBtn.style.opacity = '0.5';
      calcBtn.style.cursor = 'not-allowed';
    }
    if (!block.querySelector('.consumed-notice')) {
      const notice = document.createElement('div');
      notice.className = 'consumed-notice';
      notice.innerHTML = `
        <p>🔒 Input fields consumed. Adjust prices below to update totals.</p>
        <p style="font-size:0.8rem; font-weight:normal;">Pay KES 5 to add another calculation.</p>
      `;
      const results = block.querySelector(`.${type}-results`);
      if (results) results.parentNode.insertBefore(notice, results.nextSibling);
    }
  },

  // ===== BUILD TABLE =====
  buildTable(container, items) {
    if (!container) return;
    let detailsHtml = container.dataset?.details || '';
    let html = `
      ${detailsHtml}
      <table>
        <thead><tr><th>Item</th><th>Qty</th><th>Unit</th><th>Rate</th><th style="text-align:right;padding-right:8px;">Cost</th></tr></thead>
        <tbody>
    `;
    items.forEach(item => {
      html += `
        <tr>
          <td>${item.icon} ${item.name}</td>
          <td><input type="number" step="any" class="qty" value="${item.qty}" data-prev="${item.qty}" inputmode="decimal"></td>
          <td>${item.unit}</td>
          <td><input type="number" step="any" class="rate" value="0" data-prev="0" inputmode="decimal"></td>
          <td class="cost">0.00</td>
        </tr>
      `;
    });
    html += `
        <tr class="total-row"><th colspan="4">Item subtotal</th><th class="item-subtotal" style="text-align:right;padding-right:8px;">0.00</th></tr>
        <tr><td>👷 Labour (%)</td><td colspan="2"><input type="number" step="any" class="labourRate editable-number" value="10" data-prev="10" style="width:65px;" inputmode="decimal"></td><td colspan="2" class="labour-cost" style="text-align:right;padding-right:8px;">0.00</td></tr>
        <tr><td>📦 Misc</td><td colspan="3"><input type="number" step="any" class="miscCost editable-number" value="0" data-prev="0" style="width:70px;" inputmode="decimal"></td><td class="misc-out" style="text-align:right;padding-right:8px;">0.00</td></tr>
        <tr class="tax-row"><td>💰 Tax (%)</td><td colspan="2"><input type="number" step="any" class="taxRate editable-number" value="0" data-prev="0" style="width:65px;" inputmode="decimal"></td><td colspan="2" class="tax-out" style="text-align:right;padding-right:8px;">0.00</td></tr>
        <tr class="total-row"><th colspan="4">ITEM TOTAL</th><th class="item-grand-total" style="text-align:right;padding-right:8px;">0.00</th></tr>
      </tbody>
      </table>
    `;
    container.innerHTML = html;
    container.querySelectorAll('input').forEach(input => {
      input.addEventListener('input', (e) => {
        const target = e.target;
        if (target.value.trim() !== '') target.dataset.prev = target.value;
        const block = target.closest('.item-block');
        if (block) {
          const results = block.querySelector('.walling-results') || block.querySelector('.concrete-results') ||
                         block.querySelector('.plaster-results') || block.querySelector('.painting-results') ||
                         block.querySelector('.tiling-results');
          if (results) this.updateItemTotals(results);
          const tab = block.closest('.tab-content');
          if (tab) {
            const type = tab.id.replace('tab-', '');
            this.updateCombined(type);
          }
        }
      });
    });
    setTimeout(() => this.updateItemTotals(container), 50);
  },

  // ===== UPDATE ITEM TOTALS =====
  updateItemTotals(container) {
    if (!container) return;
    let materialTotal = 0;
    container.querySelectorAll('tr').forEach(row => {
      const qty = row.querySelector('.qty');
      const rate = row.querySelector('.rate');
      const cost = row.querySelector('.cost');
      if (qty && rate && cost) {
        const q = parseFloat(qty.value) || 0;
        const r = parseFloat(rate.value) || 0;
        const c = q * r;
        cost.textContent = c.toFixed(2);
        materialTotal += c;
      }
    });
    const subtotal = container.querySelector('.item-subtotal');
    if (subtotal) subtotal.textContent = materialTotal.toFixed(2);
    const labourInput = container.querySelector('.labourRate');
    const labourEl = container.querySelector('.labour-cost');
    let labourCost = 0;
    if (labourInput && labourEl) {
      labourCost = (parseFloat(labourInput.value) || 0) / 100 * materialTotal;
      labourEl.textContent = labourCost.toFixed(2);
    }
    const miscInput = container.querySelector('.miscCost');
    const miscEl = container.querySelector('.misc-out');
    let miscCost = 0;
    if (miscInput && miscEl) {
      miscCost = parseFloat(miscInput.value) || 0;
      miscEl.textContent = miscCost.toFixed(2);
    }
    const taxInput = container.querySelector('.taxRate');
    const taxEl = container.querySelector('.tax-out');
    let taxCost = 0;
    if (taxInput && taxEl) {
      taxCost = (parseFloat(taxInput.value) || 0) / 100 * (materialTotal + labourCost + miscCost);
      taxEl.textContent = taxCost.toFixed(2);
    }
    const grandTotal = materialTotal + labourCost + miscCost + taxCost;
    const grandEl = container.querySelector('.item-grand-total');
    if (grandEl) grandEl.textContent = grandTotal.toFixed(2);
    const block = container.closest('.item-block');
    if (block) {
      const totalEl = block.querySelector('.item-total span');
      if (totalEl) totalEl.textContent = grandTotal.toFixed(2);
    }
  },

  // ===== UPDATE COMBINED TOTALS =====
  getCombinedTotal(containerId) {
    const container = document.getElementById(containerId);
    if (!container) return 0;
    let total = 0;
    container.querySelectorAll('.item-block').forEach(block => {
      const grand = block.querySelector('.item-grand-total');
      if (grand) total += parseFloat(grand.textContent) || 0;
    });
    return total;
  },

  updateCombined(type) {
    const total = this.getCombinedTotal(`${type}-container`);
    const el = document.getElementById(`${type}-combined-total`);
    if (el) el.innerHTML = total.toFixed(2) + ' <small>currency</small>';
  },

  // ============================================================
  //  5 CALCULATOR FUNCTIONS
  // ============================================================

  // ===== WALLING CALCULATOR =====
  calcWalling(block) {
    const cementRatio = this.getVal(block, '.walling-cement-ratio') || 1;
    const sandRatio = this.getVal(block, '.walling-sand-ratio') || 3;
    const length = this.getVal(block, '.walling-block-length') || 360;
    const thickness = this.getVal(block, '.walling-block-thickness') || 180;
    const height = this.getVal(block, '.walling-block-height') || 180;
    const area = this.getVal(block, '.walling-area') || 0;

    if (area <= 0) {
      block.querySelector('.walling-results').innerHTML = `<p style="color:#b02b2b; background:#ffe6e6; padding:10px; border-radius:10px; text-align:center; margin:0; font-size:0.8rem;">⚠️ enter wall area > 0</p>`;
      return null;
    }

    const builtArea = ((length + 20) / 1000) * ((height + 20) / 1000);
    const blocks = Math.ceil(area / builtArea);
    const wallVolume = area * (thickness / 1000);
    const blockVolume = blocks * (length * thickness * height) / 1e9;
    const mortar = 1.3 * (wallVolume - blockVolume);
    const total = cementRatio + sandRatio;
    const cement = Math.ceil(cementRatio * mortar * 28.96 / total);
    const sand = Math.ceil(sandRatio * mortar * 2 / total);

    return {
      items: [
        { icon: '🧱', name: 'Blocks', qty: blocks, unit: 'pcs' },
        { icon: '🧷', name: 'Cement', qty: cement, unit: 'bags' },
        { icon: '🏖️', name: 'Sand', qty: sand, unit: 'tons' }
      ]
    };
  },

  // ===== CONCRETE CALCULATOR =====
  calcConcrete(block) {
    const cementRatio = this.getVal(block, '.concrete-cement-ratio') || 1;
    const sandRatio = this.getVal(block, '.concrete-sand-ratio') || 2;
    const ballastRatio = this.getVal(block, '.concrete-ballast-ratio') || 4;
    const volume = this.getVal(block, '.concrete-volume') || 0;

    if (volume <= 0) {
      block.querySelector('.concrete-results').innerHTML = `<p style="color:#b02b2b; background:#ffe6e6; padding:10px; border-radius:10px; text-align:center; margin:0; font-size:0.8rem;">⚠️ enter volume > 0</p>`;
      return null;
    }

    const factor = 1.54;
    const total = cementRatio + sandRatio + ballastRatio;
    const wetVolume = factor * volume;
    const cement = Math.ceil(cementRatio * wetVolume * 28.96 / total);
    const sand = Math.ceil(sandRatio * wetVolume * 2 / total);
    const ballast = Math.ceil(ballastRatio * wetVolume * 2.5 / total);

    return {
      items: [
        { icon: '🧷', name: 'Cement', qty: cement, unit: 'bags' },
        { icon: '🏖️', name: 'Sand', qty: sand, unit: 'tons' },
        { icon: '🪨', name: 'Ballast', qty: ballast, unit: 'tons' }
      ]
    };
  },

  // ===== PLASTER CALCULATOR =====
  calcPlaster(block) {
    const cementRatio = this.getVal(block, '.plaster-cement-ratio') || 1;
    const sandRatio = this.getVal(block, '.plaster-sand-ratio') || 4;
    const area = this.getVal(block, '.plaster-area') || 0;
    const thickness = this.getVal(block, '.plaster-thickness') || 15;

    if (area <= 0) {
      block.querySelector('.plaster-results').innerHTML = `<p style="color:#b02b2b; background:#ffe6e6; padding:10px; border-radius:10px; text-align:center; margin:0; font-size:0.8rem;">⚠️ enter area > 0</p>`;
      return null;
    }

    const volume = area * (thickness / 1000);
    const wetVolume = 1.3 * volume;
    const total = cementRatio + sandRatio;
    const cement = Math.ceil(cementRatio * wetVolume * 28.96 / total);
    const sand = Math.ceil(sandRatio * wetVolume * 2 / total);

    return {
      items: [
        { icon: '🧷', name: 'Cement', qty: cement, unit: 'bags' },
        { icon: '🏖️', name: 'Sand', qty: sand, unit: 'tons' }
      ]
    };
  },

  // ===== PAINTING CALCULATOR =====
  calcPainting(block) {
    const area = this.getVal(block, '.painting-area') || 100;
    const coats = this.getVal(block, '.painting-coats') || 3;
    const coverageRate = this.getVal(block, '.painting-coverage') || 10;
    const primerCoverage = this.getVal(block, '.painting-primer-coverage') || 6;
    const thinnerPercent = this.getVal(block, '.painting-thinner-percent') || 5;
    const fillerRate = this.getVal(block, '.painting-filler-rate') || 0.5;
    const structure = block.querySelector('.painting-structure')?.value || 'wall';

    const paint = Math.ceil(area * coats / coverageRate);
    const thinner = Math.ceil(thinnerPercent * paint / 100);
    const filler = Math.ceil(area * fillerRate);
    const primer = Math.ceil(area / primerCoverage);

    const detailsHtml = `
      <div class="details-box">
        <div class="detail-row"><span class="detail-label">Structure</span><span class="detail-value">${structure}</span></div>
        <div class="detail-row"><span class="detail-label">Area</span><span class="detail-value">${area} m²</span></div>
        <div class="detail-row"><span class="detail-label">Coats</span><span class="detail-value">${coats}</span></div>
      </div>
    `;

    const resultsContainer = block.querySelector('.painting-results');
    if (resultsContainer) {
      resultsContainer.dataset.details = detailsHtml;
    }

    return {
      items: [
        { icon: '🧴', name: 'Primer', qty: primer, unit: 'L' },
        { icon: '🧴', name: 'Paint', qty: paint, unit: 'L' },
        { icon: '🧴', name: 'Thinner', qty: thinner, unit: 'L' },
        { icon: '🧴', name: 'Filler', qty: filler, unit: 'kg' }
      ]
    };
  },

  // ===== TILING CALCULATOR =====
  calcTiling(block) {
    const area = this.getVal(block, '.tiling-area') || 100;
    const tileLength = this.getVal(block, '.tiling-tile-length') || 300;
    const tileWidth = this.getVal(block, '.tiling-tile-width') || 300;
    const tileThickness = this.getVal(block, '.tiling-tile-thickness') || 6;
    const tileCollection = this.getVal(block, '.tiling-tile-collection') || 16;
    const cementRatio = this.getVal(block, '.tiling-cement-ratio') || 1;
    const sandRatio = this.getVal(block, '.tiling-sand-ratio') || 3;
    const structure = block.querySelector('.tiling-structure')?.value || 'floor';

    const tiledLength = tileLength + tileThickness;
    const tiledWidth = tileWidth + tileThickness;
    const tiledArea = (tiledWidth * tiledLength) / 1000000;
    
    const tilesRequired = Math.ceil(area / tiledArea);
    const tiles = Math.ceil(tilesRequired / tileCollection);
    const tilesVolume = (tilesRequired * tileLength * tileWidth * tileThickness) / 1000000000;
    const tiledAreaVolume = (area * tileThickness * 2) / 1000;
    const volume = tiledAreaVolume - tilesVolume;
    const dryVolume = volume * 1.3;
    const total = cementRatio + sandRatio;
    const cement = Math.ceil(cementRatio * dryVolume * 28.96 / total);
    const sand = Math.ceil(sandRatio * dryVolume * 2 / total);

    const detailsHtml = `
      <div class="details-box">
        <div class="detail-row"><span class="detail-label">Structure</span><span class="detail-value">${structure}</span></div>
        <div class="detail-row"><span class="detail-label">Area</span><span class="detail-value">${area} m²</span></div>
        <div class="detail-row"><span class="detail-label">Tile Size</span><span class="detail-value">${tileLength}×${tileWidth}×${tileThickness} mm</span></div>
        <div class="detail-row"><span class="detail-label">Tiles Required</span><span class="detail-value">${tilesRequired} pcs (${tiles} boxes)</span></div>
      </div>
    `;

    const resultsContainer = block.querySelector('.tiling-results');
    if (resultsContainer) {
      resultsContainer.dataset.details = detailsHtml;
    }

    return {
      items: [
        { icon: '🧷', name: 'Cement', qty: cement, unit: 'bags' },
        { icon: '🏖️', name: 'Sand', qty: sand, unit: 'tons' },
        { icon: '🪠', name: 'Tiles', qty: tiles, unit: 'boxes' }
      ]
    };
  },

  // ===== PDF GENERATION =====
  generatePDF() {
    alert('📄 PDF generation will include all saved calculations. Coming soon!');
  },

  // ===== WHATSAPP SHARE =====
  shareToWhatsApp() {
    alert('💬 WhatsApp share will include all saved calculations. Coming soon!');
  },

  // ===== GET VAL (Helper) =====
  getVal(container, selector) {
    const el = container.querySelector(selector);
    if (!el) return 0;
    return parseFloat(el.value) || 0;
  },

  getStr(container, selector) {
    const el = container.querySelector(selector);
    if (!el) return 'excavation';
    return el.value || 'excavation';
  }
};

// ============================================================
//  INITIALIZE
// ============================================================
document.addEventListener('DOMContentLoaded', () => {
  App.init();
  const params = new URLSearchParams(window.location.search);
  const paymentStatus = params.get('payment');
  const action = params.get('action');
  if (paymentStatus === 'success') {
    const actionLabel = action ? action.replace('_', ' ').toUpperCase() : 'Action';
    alert(`✅ Payment successful! You can now add ${actionLabel}.`);
    window.history.replaceState({}, document.title, '/');
    setTimeout(() => App.loadUserCredits(), 500);
  } else if (paymentStatus === 'error') {
    const message = params.get('message') || 'Payment failed';
    alert(`❌ ${message}`);
    window.history.replaceState({}, document.title, '/');
  }
});

window.App = App;
</script>
</body>
</html>
