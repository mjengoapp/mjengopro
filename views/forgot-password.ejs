<!DOCTYPE HTML>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password · Mjengo Pro</title>
    <style>
        * {
            box-sizing: border-box;
            font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
        }
        body {
            background: #f0f4fa;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
        }
        .container {
            background: white;
            padding: 40px;
            border-radius: 20px;
            box-shadow: 0 8px 30px rgba(0,0,0,0.08);
            max-width: 440px;
            width: 100%;
        }
        .logo {
            text-align: center;
            font-size: 3rem;
            margin-bottom: 10px;
        }
        h1 {
            color: #1b3b5c;
            text-align: center;
            font-size: 1.5rem;
            margin: 0 0 8px 0;
        }
        .subtitle {
            text-align: center;
            color: #6a8aa8;
            font-size: 0.9rem;
            margin-bottom: 30px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        label {
            display: block;
            font-weight: 600;
            color: #1b3b5c;
            font-size: 0.85rem;
            margin-bottom: 6px;
        }
        input[type="email"] {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #d6e2f0;
            border-radius: 10px;
            font-size: 1rem;
            transition: 0.2s;
            background: #f8faff;
        }
        input[type="email"]:focus {
            border-color: #2a7de1;
            outline: none;
            box-shadow: 0 0 0 3px rgba(42,125,225,0.1);
            background: white;
        }
        .btn-send {
            width: 100%;
            padding: 14px;
            background: #1b3b5c;
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            transition: 0.2s;
            margin-top: 10px;
        }
        .btn-send:hover {
            background: #0d2d49;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(27, 59, 92, 0.3);
        }
        .btn-send:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
        }
        .alert {
            padding: 12px 16px;
            border-radius: 10px;
            margin-bottom: 20px;
            display: none;
            font-size: 0.9rem;
        }
        .alert.error {
            display: block;
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
        }
        .alert.success {
            display: block;
            background: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
        }
        .alert.info {
            display: block;
            background: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
        }
        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #6a8aa8;
            text-decoration: none;
            font-size: 0.9rem;
        }
        .back-link:hover {
            color: #1b3b5c;
        }
        .resend-timer {
            text-align: center;
            font-size: 0.85rem;
            color: #6a8aa8;
            margin-top: 12px;
        }
        @media (max-width: 480px) {
            .container {
                padding: 24px;
            }
            h1 {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">🔑</div>
        <h1>Forgot Password</h1>
        <p class="subtitle">Enter your email to receive a password reset link</p>

        <div id="alert" class="alert"></div>

        <form id="forgotForm">
            <div class="form-group">
                <label for="email">Email Address</label>
                <input 
                    type="email" 
                    id="email" 
                    placeholder="Enter your registered email" 
                    required 
                    autocomplete="email"
                    value="<%= email || '' %>"
                >
            </div>

            <button type="submit" class="btn-send" id="sendBtn">Send Reset Link</button>
        </form>

        <div class="resend-timer" id="timer" style="display: none;">
            You can request another link in <span id="countdown">60</span> seconds
        </div>

        <a href="/" class="back-link">← Back to Login</a>
    </div>

    <script>
        const form = document.getElementById('forgotForm');
        const emailInput = document.getElementById('email');
        const sendBtn = document.getElementById('sendBtn');
        const alertDiv = document.getElementById('alert');
        const timerDiv = document.getElementById('timer');
        const countdownSpan = document.getElementById('countdown');
        let cooldownTimer = null;
        let countdown = 60;

        function showAlert(message, type = 'error') {
            alertDiv.textContent = message;
            alertDiv.className = 'alert ' + type;
        }

        function hideAlert() {
            alertDiv.className = 'alert';
            alertDiv.textContent = '';
        }

        function startCooldown() {
            countdown = 60;
            timerDiv.style.display = 'block';
            sendBtn.disabled = true;
            
            cooldownTimer = setInterval(() => {
                countdown--;
                countdownSpan.textContent = countdown;
                
                if (countdown <= 0) {
                    clearInterval(cooldownTimer);
                    timerDiv.style.display = 'none';
                    sendBtn.disabled = false;
                    sendBtn.textContent = 'Send Reset Link';
                }
            }, 1000);
        }

        form.addEventListener('submit', async function(e) {
            e.preventDefault();
            hideAlert();

            const email = emailInput.value.trim();
            
            if (!email || !email.includes('@')) {
                showAlert('Please enter a valid email address.', 'error');
                emailInput.focus();
                return;
            }

            sendBtn.disabled = true;
            sendBtn.textContent = 'Sending...';

            try {
                const res = await fetch('/api/forgot-password', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email })
                });

                const data = await res.json();

                if (data.success) {
                    showAlert(
                        data.message || 'If your email is registered, you will receive a password reset link.',
                        'success'
                    );
                    startCooldown();
                } else {
                    showAlert(data.error || 'Failed to send reset link. Please try again.', 'error');
                    sendBtn.disabled = false;
                    sendBtn.textContent = 'Send Reset Link';
                }
            } catch (error) {
                showAlert('An error occurred. Please try again.', 'error');
                sendBtn.disabled = false;
                sendBtn.textContent = 'Send Reset Link';
            }
        });

        // Check if email was passed from query params (e.g., from failed login)
        const urlParams = new URLSearchParams(window.location.search);
        const emailParam = urlParams.get('email');
        if (emailParam) {
            emailInput.value = emailParam;
        }
    </script>
</body>
</html>
