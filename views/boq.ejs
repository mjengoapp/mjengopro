    // ============= STATE =============
    let boqItems = [];
    let expandedNodes = new Set(['substructure', 'superstructure']);
    let updateTimeout = null;
    let searchTerm = '';
    let logoDataUrl = '';
    let userCredits = {
        freeCredits: { add_boq: 0 },
        paidCredits: { add_boq: 0 },
        walletBalance: 0,
        verified: false
    };
    let selectedPackage = 50;

    // ============= DOM REFS =============
    const navTree = document.getElementById('nav-tree');
    const boqBody = document.getElementById('boq-body');
    const grandTotalSpan = document.getElementById('grand-total-value');
    const stickyTotalAmount = document.getElementById('stickyTotalAmount');
    const stickyItemsCount = document.getElementById('stickyItemsCount');
    const itemCountSpan = document.getElementById('item-count');
    const countBadge = document.getElementById('item-count-badge');
    const searchInput = document.getElementById('searchInput');
    const discountInput = document.getElementById('discountInput');
    const vatInput = document.getElementById('vatInput');
    const companyNameInput = document.getElementById('companyName');

    // ============= CREDIT SYSTEM =============
    async function fetchCredits() {
        if (!isLoggedIn) {
            document.getElementById('freeCredits').textContent = 'Login required';
            document.getElementById('paidCredits').textContent = '-';
            document.getElementById('walletBalance').textContent = 'KES 0';
            return;
        }

        try {
            const res = await fetch(`/api/check-credits/${encodeURIComponent(userEmail)}/add_boq`);
            const data = await res.json();
            
            userCredits = {
                freeCredits: { add_boq: data.freeCredits || 0 },
                paidCredits: { add_boq: data.paidCredits || 0 },
                walletBalance: data.walletBalance || 0,
                verified: data.verified || false
            };

            document.getElementById('freeCredits').textContent = data.freeCredits || 0;
            document.getElementById('paidCredits').textContent = data.paidCredits || 0;
            document.getElementById('walletBalance').textContent = `KES ${data.walletBalance || 0}`;

            if (!data.verified && isLoggedIn) {
                alert('⚠️ Please verify your email to use BOQ features. Check your email for verification link.');
            }
        } catch (error) {
            console.error('Error fetching credits:', error);
        }
    }

    async function useCredit() {
        if (!isLoggedIn) {
            alert('Please login to use BOQ features.');
            window.location.href = '/';
            return false;
        }

        if (!userCredits.verified) {
            alert('⚠️ Please verify your email first. Check your inbox for verification link.');
            return false;
        }

        const totalCredits = (userCredits.freeCredits.add_boq || 0) + (userCredits.paidCredits.add_boq || 0);
        if (totalCredits > 0) {
            try {
                const res = await fetch('/api/use-credit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: userEmail, action: 'add_boq' })
                });
                const data = await res.json();
                
                if (data.success) {
                    await fetchCredits();
                    return true;
                } else {
                    alert(data.error || 'Failed to use credit. Please try again.');
                    return false;
                }
            } catch (error) {
                console.error('Error using credit:', error);
                alert('Error processing credit. Please try again.');
                return false;
            }
        } else if (userCredits.walletBalance >= COST_PER_CALCULATION) {
            try {
                const res = await fetch('/api/use-wallet', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ email: userEmail, action: 'add_boq' })
                });
                const data = await res.json();
                
                if (data.success) {
                    await fetchCredits();
                    return true;
                } else {
                    alert(data.message || 'Insufficient wallet balance. Please buy credits.');
                    document.getElementById('buyCreditsBtn').click();
                    return false;
                }
            } catch (error) {
                console.error('Error using wallet:', error);
                alert('Error processing payment. Please try again.');
                return false;
            }
        } else {
            alert('⚠️ No credits available. You need KES 5 per calculation.\n\nFree credits: ' + (userCredits.freeCredits.add_boq || 0) + 
                  '\nPaid credits: ' + (userCredits.paidCredits.add_boq || 0) +
                  '\nWallet balance: KES ' + (userCredits.walletBalance || 0));
            document.getElementById('buyCreditsBtn').click();
            return false;
        }
    }

    // ============= BUY CREDITS =============
    document.getElementById('buyCreditsBtn').addEventListener('click', function() {
        if (!isLoggedIn) {
            alert('Please login first.');
            window.location.href = '/';
            return;
        }
        document.getElementById('creditModal').classList.add('active');
    });

    document.getElementById('closeModalBtn').addEventListener('click', function() {
        document.getElementById('creditModal').classList.remove('active');
    });

    document.querySelectorAll('.package').forEach(pkg => {
        pkg.addEventListener('click', function() {
            document.querySelectorAll('.package').forEach(p => p.classList.remove('selected'));
            this.classList.add('selected');
            selectedPackage = parseInt(this.dataset.amount);
        });
    });
    document.getElementById('pkg50').classList.add('selected');

    document.getElementById('payBtn').addEventListener('click', async function() {
        if (!isLoggedIn) {
            alert('Please login first.');
            return;
        }

        this.disabled = true;
        this.textContent = 'Processing...';

        try {
            const res = await fetch('/api/load-wallet', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: userEmail, amount: selectedPackage })
            });
            const data = await res.json();

            if (data.success && data.authorization_url) {
                window.location.href = data.authorization_url;
            } else {
                alert('Payment initialization failed: ' + (data.error || 'Unknown error'));
                this.disabled = false;
                this.textContent = 'Pay with M-Pesa';
            }
        } catch (error) {
            console.error('Payment error:', error);
            alert('Payment failed. Please try again.');
            this.disabled = false;
            this.textContent = 'Pay with M-Pesa';
        }
    });

    // ============= LOCAL STORAGE =============
    function loadFromStorage() {
        try {
            const saved = localStorage.getItem('boqData');
            if (saved) {
                const data = JSON.parse(saved);
                if (data.items) boqItems = data.items;
                if (data.companyName) companyNameInput.value = data.companyName;
                if (data.clientName) document.getElementById('clientName').value = data.clientName;
                if (data.projectName) document.getElementById('projectName').value = data.projectName;
                if (data.qsName) document.getElementById('qsName').value = data.qsName;
                if (data.projectDate) document.getElementById('projectDate').value = data.projectDate;
                if (data.discount) discountInput.value = data.discount;
                if (data.vat) vatInput.value = data.vat;
                if (data.logo) {
                    logoDataUrl = data.logo;
                    const placeholder = document.getElementById('logoPlaceholder');
                    placeholder.innerHTML = `<img src="${logoDataUrl}" alt="Logo">`;
                }
                return true;
            }
        } catch(e) { console.warn('Failed to load from storage:', e); }
        return false;
    }

    function saveToStorage() {
        try {
            const data = {
                items: boqItems,
                companyName: companyNameInput.value,
                clientName: document.getElementById('clientName').value,
                projectName: document.getElementById('projectName').value,
                qsName: document.getElementById('qsName').value,
                projectDate: document.getElementById('projectDate').value,
                discount: discountInput.value,
                vat: vatInput.value,
                logo: logoDataUrl,
                savedAt: new Date().toISOString()
            };
            localStorage.setItem('boqData', JSON.stringify(data));
        } catch(e) { console.warn('Failed to save to storage:', e); }
    }

    // ============= HELPERS =============
    function formatMoney(value) {
        return 'KES ' + Number(value).toLocaleString('en-KE', {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    function getNode(path) {
        let parts = path.split('.');
        let current = DATA;
        for (let p of parts) {
            if (current && current.children && current.children[p]) {
                current = current.children[p];
            } else if (current && current[p]) {
                current = current[p];
            } else {
                return null;
            }
        }
        return current;
    }

    function getAllItems(node) {
        let result = [];
        if (node.items) {
            result = result.concat(node.items);
        }
        if (node.children) {
            for (let key in node.children) {
                result = result.concat(getAllItems(node.children[key]));
            }
        }
        return result;
    }

    function getLevels(path) {
        let parts = path.split('.');
        let levels = [];
        let current = DATA;
        for (let p of parts) {
            if (current && current.children && current.children[p]) {
                current = current.children[p];
                if (current.label) levels.push(current.label);
            } else if (current && current[p]) {
                current = current[p];
                if (current.label) levels.push(current.label);
            } else {
                break;
            }
        }
        return levels;
    }

    function generateId() {
        return 'item_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6);
    }

    function isItemDuplicate(item, levels) {
        return boqItems.some(existing =>
            existing.title === item.title &&
            existing.levels.join() === levels.join()
        );
    }

    // ============= CALCULATE TOTALS =============
    function calculateTotals() {
        let subtotal = 0;
        boqItems.forEach(item => {
            subtotal += (item.rate || 0) * (item.qty || 0);
        });

        const discount = parseFloat(discountInput.value) || 0;
        const vat = parseFloat(vatInput.value) || 0;

        let afterDiscount = subtotal - (subtotal * discount / 100);
        let afterVat = afterDiscount + (afterDiscount * vat / 100);

        return {
            subtotal: subtotal,
            discount: discount,
            vat: vat,
            discountAmount: subtotal * discount / 100,
            vatAmount: afterDiscount * vat / 100,
            grandTotal: afterVat,
            itemCount: boqItems.length
        };
    }

    function updateTotals() {
        const totals = calculateTotals();
        grandTotalSpan.textContent = formatMoney(totals.grandTotal);
        stickyTotalAmount.textContent = formatMoney(totals.grandTotal);
        stickyItemsCount.textContent = totals.itemCount + ' items';
        itemCountSpan.textContent = totals.itemCount;
        countBadge.textContent = totals.itemCount + ' items';
        saveToStorage();
    }

    // ============= RENDER TREE =============
    function renderTree() {
        navTree.innerHTML = '';
        let keys = Object.keys(DATA);
        keys.forEach(key => {
            let node = DATA[key];
            let path = key;
            let isExpanded = expandedNodes.has(path);

            let div = document.createElement('div');
            div.className = 'tree-item level-0';

            let arrow = document.createElement('span');
            arrow.className = 'arrow';
            arrow.textContent = isExpanded ? '▼' : '▶';
            div.appendChild(arrow);

            let label = document.createElement('span');
            label.textContent = node.label;
            div.appendChild(label);

            let count = getAllItems(node).length;
            if (count > 0) {
                let badge = document.createElement('span');
                badge.className = 'item-count';
                badge.textContent = count;
                div.appendChild(badge);
            }

            div.addEventListener('click', function(e) {
                if (e.target.closest('.btn-add-all') || e.target.closest('.btn-add-single')) return;
                if (expandedNodes.has(path)) {
                    expandedNodes.delete(path);
                } else {
                    expandedNodes.add(path);
                }
                renderTree();
            });

            navTree.appendChild(div);

            if (isExpanded) {
                let container = document.createElement('div');
                container.style.paddingLeft = '0px';
                navTree.appendChild(container);
                buildTree(container, node, path, 1);
            }
        });
    }

    function buildTree(parent, node, path, level) {
        let keys = Object.keys(node.children || {});
        keys.sort();

        keys.forEach(key => {
            let child = node.children[key];
            let fullPath = path + '.' + key;
            let hasChildren = child.children && Object.keys(child.children).length > 0;
            let hasItems = child.items && child.items.length > 0;
            let isExpanded = expandedNodes.has(fullPath);

            let show = true;
            if (searchTerm) {
                let found = false;
                if (child.label && child.label.toLowerCase().includes(searchTerm)) found = true;
                if (child.items) {
                    child.items.forEach(item => {
                        if (item.title.toLowerCase().includes(searchTerm)) found = true;
                        if (item.desc && item.desc.toLowerCase().includes(searchTerm)) found = true;
                    });
                }
                show = found;
            }
            if (!show) return;

            let div = document.createElement('div');
            div.className = 'tree-item level-' + level;

            if (hasChildren) {
                let arrow = document.createElement('span');
                arrow.className = 'arrow';
                arrow.textContent = isExpanded ? '▼' : '▶';
                div.appendChild(arrow);
            } else {
                let spacer = document.createElement('span');
                spacer.style.width = '14px';
                spacer.style.display = 'inline-block';
                div.appendChild(spacer);
            }

            let label = document.createElement('span');
            label.textContent = child.label;
            div.appendChild(label);

            if (hasItems) {
                let btn = document.createElement('button');
                btn.className = 'btn-add-all';
                btn.textContent = '+ All';
                btn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    addCategory(fullPath);
                });
                div.appendChild(btn);

                let items = child.items || [];
                if (items.length > 0) {
                    let badge = document.createElement('span');
                    badge.className = 'item-count';
                    badge.textContent = items.length;
                    div.appendChild(badge);
                }

                if (isExpanded || level <= 1) {
                    let sub = document.createElement('div');
                    sub.className = 'sub-items';
                    child.items.forEach(item => {
                        let row = document.createElement('div');
                        row.className = 'sub-item';

                        let name = document.createElement('span');
                        name.className = 'item-preview';
                        name.textContent = item.title;
                        row.appendChild(name);

                        let unit = document.createElement('span');
                        unit.className = 'item-unit';
                        unit.textContent = item.unit;
                        row.appendChild(unit);

                        let btn2 = document.createElement('button');
                        btn2.className = 'btn-add-single';
                        btn2.textContent = '+ Add';
                        btn2.addEventListener('click', function(e) {
                            e.stopPropagation();
                            addSingle(item, fullPath);
                        });
                        row.appendChild(btn2);

                        sub.appendChild(row);
                    });
                    div.appendChild(sub);
                }
            }

            div.addEventListener('click', function(e) {
                if (e.target.closest('.btn-add-all') || e.target.closest('.btn-add-single')) return;
                if (hasChildren) {
                    if (expandedNodes.has(fullPath)) {
                        expandedNodes.delete(fullPath);
                    } else {
                        expandedNodes.add(fullPath);
                    }
                    renderTree();
                }
            });

            parent.appendChild(div);

            if (hasChildren && isExpanded) {
                let container = document.createElement('div');
                container.style.paddingLeft = '0px';
                parent.appendChild(container);
                buildTree(container, child, fullPath, level + 1);
            }
        });
    }

    // ============= ADD ITEMS WITH CREDIT CHECK =============
    async function addSingle(item, path) {
        let levels = getLevels(path);

        // Check credits before adding
        const hasCredit = await useCredit();
        if (!hasCredit) return;

        if (isItemDuplicate(item, levels)) {
            let existing = boqItems.find(i => i.title === item.title && i.levels.join() === levels.join());
            if (existing) {
                existing.qty = (existing.qty || 1) + 1;
                renderTable();
            }
            return;
        }

        boqItems.push({
            id: generateId(),
            title: item.title,
            description: item.desc || item.description || '',
            unit: item.unit || 'unit',
            rate: item.rate || 0,
            qty: 1,
            levels: levels,
            createdAt: new Date().toISOString()
        });
        renderTable();
    }

    async function addCategory(path) {
        let node = getNode(path);
        if (!node) return;
        
        let allItems = getAllItems(node);
        let levels = getLevels(path);

        // Check credits before adding (one credit per category)
        const hasCredit = await useCredit();
        if (!hasCredit) return;

        allItems.forEach(item => {
            if (isItemDuplicate(item, levels)) {
                let existing = boqItems.find(i => i.title === item.title && i.levels.join() === levels.join());
                if (existing) {
                    existing.qty = (existing.qty || 1) + 1;
                }
            } else {
                boqItems.push({
                    id: generateId(),
                    title: item.title,
                    description: item.desc || item.description || '',
                    unit: item.unit || 'unit',
                    rate: item.rate || 0,
                    qty: 1,
                    levels: levels,
                    createdAt: new Date().toISOString()
                });
            }
        });
        renderTable();
    }

    // ============= RENDER TABLE =============
    function renderTable() {
        if (boqItems.length === 0) {
            boqBody.innerHTML = '<tr><td colspan="6" class="empty-message">No items added.<br>Expand the structure and click + Add on any item.</td></tr>';
            updateTotals();
            return;
        }

        let hierarchy = {};
        boqItems.forEach(item => {
            let levels = item.levels || ['General'];
            let current = hierarchy;
            levels.forEach((level, idx) => {
                if (!current[level]) {
                    current[level] = { label: level, level: idx, items: [], children: {} };
                }
                if (idx === levels.length - 1) {
                    current[level].items.push(item);
                }
                current = current[level].children;
            });
        });

        let html = '';

        function renderLevel(node, level) {
            let keys = Object.keys(node).sort();
            keys.forEach(key => {
                let child = node[key];
                let childLevel = child.level || level;
                let itemsList = child.items || [];
                let hasChildren = Object.keys(child.children || {}).length > 0;

                let subtotal = 0;
                itemsList.forEach(item => {
                    subtotal += (item.rate || 0) * (item.qty || 0);
                });
                if (hasChildren) {
                    let childKeys = Object.keys(child.children || {});
                    childKeys.forEach(ck => {
                        let gc = child.children[ck];
                        if (gc.items) {
                            gc.items.forEach(item => {
                                subtotal += (item.rate || 0) * (item.qty || 0);
                            });
                        }
                    });
                }

                let cls = '';
                let badge = '';
                let pad = 12 + (childLevel * 12);
                if (childLevel === 0) {
                    cls = 'level-0';
                    badge = '📁 ';
                    pad = 12;
                } else if (childLevel === 1) {
                    cls = 'level-1';
                    badge = '▸ ';
                    pad = 24;
                } else {
                    cls = 'level-2';
                    badge = '';
                    pad = 36;
                }

                let subCls = childLevel === 0 ? 'level-0-sub' : (childLevel === 1 ? 'level-1-sub' : '');

                html += `<tr class="${cls}">
                    <td style="padding-left:${pad}px;">${badge}${key} ${itemsList.length > 0 ? `<span style="font-weight:400;font-size:11px;color:#5a7a9a;">(${itemsList.length})</span>` : ''}</td>
                    <td></td><td></td><td></td>
                    <td class="subtotal-cell ${subCls}">${formatMoney(subtotal)}</td>
                    <td></td>
                </tr>`;

                itemsList.forEach((item) => {
                    let total = (item.rate || 0) * (item.qty || 0);
                    let ipad = pad + 12;
                    html += `<tr class="item-row" data-id="${item.id}">
                        <td style="padding-left:${ipad}px;">
                            <div style="display:flex; flex-direction:column; gap:3px;">
                                <input type="text" class="item-title-input" data-field="title" value="${esc(item.title)}" data-id="${item.id}">
                                <textarea class="item-desc-input" data-field="description" rows="2" data-id="${item.id}">${esc(item.description)}</textarea>
                            </div>
                        </td>
                        <td><input type="text" class="editable-input" data-field="unit" value="${esc(item.unit)}" style="max-width:70px;" data-id="${item.id}"></td>
                        <td><input type="number" class="editable-input rate-input" data-field="rate" value="${item.rate}" step="any" min="0" data-id="${item.id}"></td>
                        <td>
                            <div class="qty-buttons">
                                <button class="qty-btn" data-id="${item.id}" data-delta="-1">−</button>
                                <input type="number" class="editable-input qty-input" data-field="qty" value="${item.qty}" step="1" min="0" data-id="${item.id}">
                                <button class="qty-btn" data-id="${item.id}" data-delta="1">+</button>
                            </div>
                        </td>
                        <td class="total-cell">${formatMoney(total)}</td>
                        <td><button class="remove-btn" data-id="${item.id}">✕</button></td>
                    </tr>`;
                });

                if (hasChildren) {
                    renderLevel(child.children, childLevel + 1);
                }
            });
        }

        renderLevel(hierarchy, 0);
        boqBody.innerHTML = html;
        updateTotals();
        attachEvents();
    }

    function esc(text) {
        if (!text) return '';
        return String(text).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // ============= EVENTS =============
    function attachEvents() {
        document.querySelectorAll('.remove-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                let id = this.getAttribute('data-id');
                let idx = boqItems.findIndex(i => i.id === id);
                if (idx !== -1) {
                    boqItems.splice(idx, 1);
                    renderTable();
                }
            });
        });

        document.querySelectorAll('.qty-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                let id = this.getAttribute('data-id');
                let delta = parseInt(this.getAttribute('data-delta'));
                let item = boqItems.find(i => i.id === id);
                if (item) {
                    item.qty = Math.max(0, (item.qty || 0) + delta);
                    renderTable();
                }
            });
        });

        document.querySelectorAll('.item-title-input, .item-desc-input, .editable-input').forEach(input => {
            input.addEventListener('change', function() {
                let id = this.getAttribute('data-id');
                let field = this.getAttribute('data-field');
                let val = this.value;
                if (field === 'rate' || field === 'qty') {
                    val = parseFloat(val) || 0;
                    if (val < 0) val = 0;
                }
                let item = boqItems.find(i => i.id === id);
                if (item) {
                    item[field] = val;
                    clearTimeout(updateTimeout);
                    updateTimeout = setTimeout(() => {
                        renderTable();
                    }, 300);
                }
            });
        });
    }

    // ============= SEARCH =============
    searchInput.addEventListener('input', function() {
        searchTerm = this.value.toLowerCase().trim();
        renderTree();
    });

    // ============= ACTIONS =============
    document.getElementById('clear-all-btn').addEventListener('click', function() {
        if (boqItems.length === 0) return;
        if (confirm('Remove all items from BOQ?')) {
            boqItems = [];
            renderTable();
        }
    });

    document.getElementById('recalc-btn').addEventListener('click', function() {
        renderTable();
    });

    document.getElementById('expand-all-btn').addEventListener('click', function() {
        function collect(node, path) {
            if (node.children) {
                for (let key in node.children) {
                    let p = path ? path + '.' + key : key;
                    expandedNodes.add(p);
                    collect(node.children[key], p);
                }
            }
        }
        for (let key in DATA) {
            expandedNodes.add(key);
            collect(DATA[key], key);
        }
        renderTree();
    });

    // ============= SAVE / LOAD / EXPORT =============
    document.getElementById('saveBtn').addEventListener('click', function() {
        saveToStorage();
        alert('✅ BOQ saved successfully! Data is stored in your browser.');
    });

    document.getElementById('loadBtn').addEventListener('click', function() {
        document.getElementById('fileInput').click();
    });

    document.getElementById('exportBtn').addEventListener('click', function() {
        const data = {
            company: companyNameInput.value,
            client: document.getElementById('clientName').value,
            project: document.getElementById('projectName').value,
            qs: document.getElementById('qsName').value,
            date: document.getElementById('projectDate').value,
            discount: discountInput.value,
            vat: vatInput.value,
            items: boqItems,
            exportedAt: new Date().toISOString()
        };
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `BOQ_${data.project || 'project'}_${new Date().toISOString().slice(0,10)}.json`;
        a.click();
        URL.revokeObjectURL(url);
    });

    document.getElementById('fileInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                const data = JSON.parse(e.target.result);
                if (data.items && Array.isArray(data.items)) {
                    boqItems = data.items;
                    if (data.client) document.getElementById('clientName').value = data.client;
                    if (data.project) document.getElementById('projectName').value = data.project;
                    if (data.qs) document.getElementById('qsName').value = data.qs;
                    if (data.date) document.getElementById('projectDate').value = data.date;
                    if (data.discount) discountInput.value = data.discount;
                    if (data.vat) vatInput.value = data.vat;
                    if (data.company) companyNameInput.value = data.company;
                    renderTable();
                    saveToStorage();
                    alert('✅ BOQ loaded successfully!');
                } else {
                    alert('❌ Invalid file format');
                }
            } catch(err) {
                alert('❌ Error loading file: ' + err.message);
            }
        };
        reader.readAsText(file);
        this.value = '';
    });

    // ============= LOGO UPLOAD =============
    document.getElementById('logoInput').addEventListener('change', function(e) {
        const file = e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(e) {
            logoDataUrl = e.target.result;
            const placeholder = document.getElementById('logoPlaceholder');
            placeholder.innerHTML = `<img src="${logoDataUrl}" alt="Logo">`;
            saveToStorage();
        };
        reader.readAsDataURL(file);
    });

    // ============= PRINT =============
    document.getElementById('printBtn').addEventListener('click', function() {
        window.print();
    });

    // ============= VAT & DISCOUNT CHANGE =============
    discountInput.addEventListener('change', updateTotals);
    vatInput.addEventListener('change', updateTotals);

    // ============= AUTO-SAVE =============
    document.querySelectorAll('.header-info input, .company-header input').forEach(input => {
        input.addEventListener('change', saveToStorage);
    });

    // ============= INIT =============
    document.getElementById('projectDate').value = new Date().toISOString().split('T')[0];

    const loaded = loadFromStorage();
    
    // Fetch credits if logged in
    if (isLoggedIn) {
        fetchCredits();
    } else {
        document.getElementById('creditBanner').style.display = 'none';
    }

    renderTree();
    renderTable();

    if (!loaded) {
        saveToStorage();
    }

    // Refresh credits every 30 seconds
    if (isLoggedIn) {
        setInterval(fetchCredits, 30000);
    }

    console.log('🏗️ BOQ Pro loaded successfully');
    console.log('📊 Items:', boqItems.length);
    console.log('👤 Logged in:', isLoggedIn);
    console.log('📧 Email:', userEmail);
</script>
</body>
</html>
